rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 1. Users & Subcollections
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /following/{followingId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /recommendations/{recId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /stats/{statId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Usernames (Public read, authenticated claim)
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // 4. Lists
    match /lists/{listId} {
      allow read: if resource.data.visibility == "public" 
        || (isAuthenticated() && request.auth.uid == resource.data.ownerId);
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && request.auth.uid == resource.data.ownerId) || isAdmin();
    }

    // 5. Watchlist
    match /watchlist/{itemId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }
    
    // 6. Saved Activities
    match /savedActivities/{itemId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // 7. Activities (Feed posts, etc.)
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // 8. Notifications
    match /notifications/{notifId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }

    // 9. Reports (Write-only for users, Read-only for admins)
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // 10. Clubs
    match /clubs/{clubId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && request.auth.uid == resource.data.ownerId) || isAdmin();
      
      match /members/{memberId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
      match /messages/{messageId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // 11. Challenges
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /participants/{participantId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
    
    // 12. WatchTracking
    match /watchTracking/{trackingId} {
      allow read: if true;
      allow write: if (isAuthenticated() && request.auth.uid == resource.data.userId) || isAdmin();
    }
  }
}
